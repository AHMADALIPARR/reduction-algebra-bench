//
// Experiment 04 — SaC (Single Assignment C) track of the reduction-algebra
// benchmark.
//
// Semantics (normative):
//   * SplitMix64, seed 0x00BEEFCAFE, COUNTER-INCREMENT variant:
//         state_k = seed + (k+1) * 0x9E3779B97F4A7C15   (mod 2^64)
//         z = mix(state_k);  emit z mod p
//     Canonical stream checksum (first 1024 values, sum mod p): 1388262917130611548
//     (see substrate/splitmix64.py and wolfram/exp02/PRNG_DIVERGENCE_NOTE.md).
//   * Goldilocks field p = 2^64 - 2^32 + 1 = 18446744069414584321.
//   * SUBLEQ branch predicate (SPECIFIED): taken iff d <= 0, i.e. on canonical
//     unsigned reps, taken iff rep == 0 or rep > p/2.
//   * 11 reduction ops: sum, product, min, max, scan, tree_reduction,
//     segmented_reduction, subleq_subtract, subleq_compare, subleq_route,
//     subleq_reduce; 4-stage attention pipeline (subtract -> compare ->
//     route -> reduce); 2 Goldilocks arith ops (subleq_subtract, subleq_multiply)
//     on values [2, 3, 4].
//
// Style: idiomatic SaC — with-loops for array construction, fold() for
// reductions, rank-generic where natural. SaC unsigned 64-bit arithmetic
// wraps mod 2^64, which is exactly what SplitMix64 needs.
//
// STATUS (2026-10-01): sac2c is NOT installed in this environment and could
// not be installed (see RUNLOG.md). This file has therefore NOT been compiled
// or executed; every measured value in results/exp04_sac.json is null with
// provenance "unknown". The implementation is complete and written to be
// compiled with:  sac2c -o exp04_sac exp04_sac.sac

use StdIO: all;
use Array: all;

/* ---------------- Goldilocks field (p = 2^64 - 2^32 + 1) ---------------- */

ulong GOLDILOCKS_P()
{
    /* 2^64 - 2^32 + 1. Written as the sum so no literal overflows. */
    return 18446744069414584320ul + 1ul;
}

/* gfAdd: (x + y) mod p, x and y canonical (< p). */
ulong gfAdd(ulong x, ulong y)
{
    ulong p = GOLDILOCKS_P();
    ulong s = x + y;                 /* wraps mod 2^64 */
    if (s < x) {
        /* overflow: x + y >= 2^64, true sum in [2^64, 2p).
           result = s + 2^64 - p = s - (2^32 - 1). */
        s = s - 4294967295ul;
    } else if (s >= p) {
        s = s - p;
    }
    return s;
}

/* gfSub: (x - y) mod p, canonical. */
ulong gfSub(ulong x, ulong y)
{
    ulong p = GOLDILOCKS_P();
    if (x >= y) {
        return x - y;
    } else {
        /* x - y + p; p - y does not overflow since y < p <= 2^64 - 1. */
        return x + (p - y);
    }
}

/* gfMul: (x * y) mod p via double-and-add, mirroring the reference cores. */
ulong gfMul(ulong x, ulong y)
{
    ulong acc = 0ul;
    ulong a = x;
    ulong b = y;
    while (b != 0ul) {
        if ((b & 1ul) != 0ul) {
            acc = gfAdd(acc, a);
        }
        a = gfAdd(a, a);
        b = b >> 1;
    }
    return acc;
}

/* SUBLEQ branch predicate, SPECIFIED: taken iff d <= 0, i.e. rep == 0 or
   rep > p/2 on the canonical unsigned representative. */
bool subleqTaken(ulong d)
{
    ulong p = GOLDILOCKS_P();
    return (d == 0ul) || (d > p / 2ul);
}

/* ---------------- SplitMix64 (counter-increment variant) ---------------- */

ulong splitmix64Mix(ulong state)
{
    ulong z = state;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5Bul;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EBul;
    z = z ^ (z >> 31);
    return z % GOLDILOCKS_P();
}

/* k-th stream value (0-based): state = seed + (k+1)*INC, then mix, mod p. */
ulong splitmix64At(int k)
{
    ulong seed = 0x00BEEFCAFEul;
    ulong inc  = 0x9E3779B97F4A7C15ul;
    ulong state = seed + (ulong)(k + 1) * inc;   /* wraps mod 2^64 */
    return splitmix64Mix(state);
}

/* Canonical 1024-element stream as a with-loop (data-parallel by default). */
ulong[1024] prngStream()
{
    return with {
        ([0] <= iv < [1024]) : splitmix64At(iv[0]);
    } : genarray([1024], 0ul);
}

/* ---------------- 11 reduction operations ---------------- */

/* seq sum: single left fold. */
ulong reduceSeq(ulong[.] X)
{
    return fold(gfAdd, 0ul, X);
}

/* tree reduction: pairwise combining until one value remains. */
ulong reduceTree(ulong[.] X)
{
    n = shape(X)[0];
    cur = X;
    while (n > 1) {
        half = (n + 1) / 2;
        cur = with {
            ([0] <= iv < [half]) :
                (2*iv[0] + 1 < n)
                ? gfAdd(cur[2*iv[0]], cur[2*iv[0] + 1])
                : cur[2*iv[0]];
        } : genarray([half], 0ul);
        n = half;
    }
    return cur[0];
}

/* sum of X[lo..hi). */
ulong rangeSum(ulong[.] X, int lo, int hi)
{
    return fold(gfAdd, 0ul,
                with {
                    ([0] <= jv < [hi - lo]) : X[lo + jv[0]];
                } : genarray([hi - lo], 0ul));
}

/* chunked reduction: per-chunk folds, then fold of chunk results. */
ulong reduceChunked(ulong[.] X, int chunks)
{
    n = shape(X)[0];
    width = (n + chunks - 1) / chunks;
    partial = with {
        ([0] <= iv < [chunks]) :
            rangeSum(X, iv[0]*width,
                     (iv[0]+1)*width < n ? (iv[0]+1)*width : n);
    } : genarray([chunks], 0ul);
    return fold(gfAdd, 0ul, partial);
}

/* product: fold with gfMul. */
ulong reduceProduct(ulong[.] X)
{
    return fold(gfMul, 1ul, X);
}

/* min / max over canonical reps. */
ulong umin(ulong a, ulong b)
{
    return a < b ? a : b;
}

ulong umax(ulong a, ulong b)
{
    return a > b ? a : b;
}

ulong reduceMin(ulong[.] X)
{
    return fold(umin, GOLDILOCKS_P() - 1ul, X);
}

ulong reduceMax(ulong[.] X)
{
    return fold(umax, 0ul, X);
}

/* prefix element i: fold of X[0..i]. With-loops are pure, so the scan is
   expressed as one prefix fold per output element (O(n^2) work, obviously
   correct; a production version tiles this). */
ulong prefixAt(ulong[.] X, int i)
{
    return fold(gfAdd, 0ul,
                with {
                    ([0] <= jv < [i + 1]) : X[jv[0]];
                } : genarray([i + 1], 0ul));
}

/* prefix scan (additive). */
ulong[.] scanAdd(ulong[.] X)
{
    n = shape(X)[0];
    return with {
        ([0] <= iv < [n]) : prefixAt(X, iv[0]);
    } : genarray([n], 0ul);
}

/* segmented reduction: SEG holds segment start indices (ascending);
   segment i covers [SEG[i], SEG[i+1]) (last runs to n). */
ulong[.] segmentedReduce(ulong[.] X, int[.] SEG)
{
    nseg = shape(SEG)[0];
    n = shape(X)[0];
    return with {
        ([0] <= iv < [nseg]) :
            rangeSum(X, SEG[iv[0]],
                     iv[0]+1 < nseg ? SEG[iv[0]+1] : n);
    } : genarray([nseg], 0ul);
}

/* ---------------- SUBLEQ attention pipeline ----------------
   Stage 1 (subleq_subtract): D = K - Q (field subtraction).
   Stage 2 (subleq_compare):  T = taken(D) per SPECIFIED predicate.
   Stage 3 (subleq_route):    routed V where taken, else 0.
   Stage 4 (subleq_reduce):   fold of the routed values. */

/* Stage 1: elementwise field subtraction. */
ulong[.] subleqSubtract(ulong[.] K, ulong[.] Q)
{
    n = shape(K)[0];
    return with {
        ([0] <= iv < [n]) : gfSub(K[iv[0]], Q[iv[0]]);
    } : genarray([n], 0ul);
}

/* Stage 2: predicate mask (1 = taken, 0 = not taken). */
int[.] subleqCompare(ulong[.] D)
{
    n = shape(D)[0];
    return with {
        ([0] <= iv < [n]) : subleqTaken(D[iv[0]]) ? 1 : 0;
    } : genarray([n], 0);
}

/* Stage 3: route V through the taken mask. */
ulong[.] subleqRoute(ulong[.] V, int[.] T)
{
    n = shape(V)[0];
    return with {
        ([0] <= iv < [n]) : (T[iv[0]] == 1) ? V[iv[0]] : 0ul;
    } : genarray([n], 0ul);
}

/* Stage 4: fold the routed values. */
ulong subleqReduce(ulong[.] routed)
{
    return fold(gfAdd, 0ul, routed);
}

/* Full 4-stage pipeline = subleqSubtract -> subleqCompare -> subleqRoute
   -> subleqReduce, composed in main() below. */

/* ---------------- driver ---------------- */

int main()
{
    /* Canonical stream and cross-language checksum gate. */
    S = prngStream();
    checksum = fold(gfAdd, 0ul, S);
    printf("crosslang_checksum: %lu\n", checksum);
    /* Expected: 1388262917130611548 (see substrate/splitmix64.py).
       verify-before-record: if this does not match, stop — no results. */

    /* 11 reduction ops on the stream. */
    printf("seq_sum:   %lu\n", reduceSeq(S));
    printf("tree_sum:  %lu\n", reduceTree(S));
    printf("chunk_sum: %lu\n", reduceChunked(S, 8));
    printf("product:   %lu\n", reduceProduct(S));
    printf("min:       %lu\n", reduceMin(S));
    printf("max:       %lu\n", reduceMax(S));
    sc = scanAdd(S);
    printf("scan_last: %lu\n", sc[1023]);

    /* Segmented reduction: 8 equal segments of 128. */
    SEG = with {
        ([0] <= iv < [8]) : iv[0] * 128;
    } : genarray([8], 0);
    segs = segmentedReduce(S, SEG);
    printf("segmented_total: %lu\n", fold(gfAdd, 0ul, segs));

    /* SUBLEQ ops and the 4-stage attention pipeline on K/Q/V slices. */
    K = with { ([0] <= iv < [64]) : S[iv[0]]; } : genarray([64], 0ul);
    Q = with { ([0] <= iv < [64]) : S[64 + iv[0]]; } : genarray([64], 0ul);
    V = with { ([0] <= iv < [64]) : S[128 + iv[0]]; } : genarray([64], 0ul);
    D = subleqSubtract(K, Q);
    T = subleqCompare(D);
    R = subleqRoute(V, T);
    res = subleqReduce(R);
    printf("subleq_subtract[0]: %lu\n", D[0]);
    printf("subleq_compare_taken: %d\n", fold(add, 0, T));
    printf("subleq_route_sum: %lu\n", fold(gfAdd, 0ul, R));
    printf("subleq_reduce: %lu\n", res);

    /* Goldilocks arithmetic spot checks on values [2, 3, 4]. */
    printf("gfSub(3,5) mod p: %lu\n", gfSub(3ul, 5ul));   /* expect p-2 */
    printf("gfMul(2,3): %lu\n", gfMul(2ul, 3ul));          /* expect 6 */
    printf("gfMul(p-1,2) mod p: %lu\n", gfMul(GOLDILOCKS_P() - 1ul, 2ul)); /* expect p-2 */

    /* Timing (3 warmup, 20 samples, median) would go here via an extrinsic
       clock; SaC stdlib exposes none, so timing is out of scope for this
       track until a clock extrinsic is wired. See results/exp04_sac.json. */
    return 0;
}
